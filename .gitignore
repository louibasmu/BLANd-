# ---------------------------------------------------------------
# BLANd .gitignore — keeps the repo to files the game actually needs
# ---------------------------------------------------------------

# Godot 4 editor cache (rebuilt automatically when the project opens)
.godot/ 
# Godot 3 cache (in case anyone opens an old copy)
.import/

# Godot export settings that can contain personal paths/passwords
export_credentials.cfg

# Godot C#/Mono build output (not used now, but harmless to ignore)
.mono/
data_*/
mono_crash.*.json

# Backup / temp files
*.bak
*.tmp
*~

# macOS Finder files
.DS_Store
._*

# Windows files
Thumbs.db
desktop.ini

# Editor settings
.vscode/
.idea/

# Third-party addon cloned with its own git history (not used by BaseGame).
# Remove this line if the team decides to use it; delete its inner .git folder first.
Add ons/simple-card-pile-ui/
